{
  "name": "farmeasy-crm-fe",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "nx serve shell",
    "start:dashboard": "nx serve mfe-dashboard --port=4200",
    "start:leads": "nx serve mfe-leads --port=4203",
    "start:opportunities": "nx serve mfe-opportunities --port=4204",
    "start:orders": "nx serve mfe-orders --port=4205",
    "start:buyers": "nx serve mfe-buyers --port=4206",
    "start:farmers": "nx serve mfe-farmers --port=4207",
    "start:commodities": "nx serve mfe-commodities --port=4208",
    "start:tickets": "nx serve mfe-tickets --port=4201",
    "start:analytics": "nx serve mfe-analytics --port=4209",
    "start:settings": "nx serve mfe-settings --port=4210",
    "start:all": "concurrently \"npm run start:tickets\" \"npm run start:dashboard\" \"npm run start:leads\" \"npm run start:opportunities\" \"npm run start\" ",
    "build": "nx build shell",
    "build:all": "nx run-many --target=build --all",
    "test": "nx test",
    "lint": "nx lint",
    "nx": "nx"
  },
  "dependencies": {
    "@angular-architects/module-federation": "^21.2.2",
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ngrx/signals": "^21.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@nx/angular": "^22.7.1",
    "@nx/workspace": "^22.7.1",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "ngx-build-plus": "^20.0.0",
    "nx": "^22.7.1",
    "typescript": "~6.0.0"
  }
