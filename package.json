{
  "name": "nexus-crm-ui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve shell",
    "start:tickets": "ng serve tickets-mfe --port 4201",
    "start:all": "concurrently \"npm run start:tickets\" \"npm run start\"",
    "build": "ng build shell",
    "build:tickets": "ng build tickets-mfe",
    "build:all": "ng build tickets-mfe && ng build shell",
    "test": "ng test",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular-architects/module-federation": "^21.2.2",
    "@angular-architects/native-federation": "^21.2.3",
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "ngx-build-plus": "^20.0.0",
    "typescript": "~6.0.0"
  }
