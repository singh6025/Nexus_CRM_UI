{
  "name": "mfe-buyers",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/mfe-buyers/src",
  "prefix": "buyers",
  "targets": {
    "build": {
      "executor": "ngx-build-plus:browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/mfe-buyers",
        "index": "apps/mfe-buyers/src/index.html",
        "main": "apps/mfe-buyers/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/mfe-buyers/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": ["apps/mfe-buyers/src/favicon.ico"],
        "styles": ["@angular/material/prebuilt-themes/indigo-pink.css"],
        "scripts": [],
        "extraWebpackConfig": "apps/mfe-buyers/webpack.config.js",
        "commonChunk": false
      },
      "configurations": {
        "production": { "outputHashing": "all" },
        "development": { "buildOptimizer": false, "optimization": false, "sourceMap": true }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "ngx-build-plus:dev-server",
      "options": { "port": 4206, "extraWebpackConfig": "apps/mfe-buyers/webpack.config.js", "publicHost": "http://localhost:4206" },
      "configurations": {
        "production": { "buildTarget": "mfe-buyers:build:production" },
        "development": { "buildTarget": "mfe-buyers:build:development" }
      },
      "defaultConfiguration": "development"
    }
  }
}
